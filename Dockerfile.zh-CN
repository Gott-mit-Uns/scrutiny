# syntax=docker/dockerfile:1.4

# Compile the audited Simplified Chinese frontend from this repository.
FROM --platform=${BUILDPLATFORM} node AS frontendbuild

WORKDIR /go/src/github.com/analogj/scrutiny

COPY Makefile ./
COPY webapp/frontend ./webapp/frontend

RUN make binary-frontend

# Keep the official v0.9.2 backend, collector, smartmontools and InfluxDB.
FROM ghcr.io/analogj/scrutiny:v0.9.2-omnibus

COPY --link --from=frontendbuild --chmod=644 \
    /go/src/github.com/analogj/scrutiny/dist \
    /opt/scrutiny/web
